# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Carried over from the previous site so the security headers are not lost in the
# redesign, with the caching rules extended to cover this site's asset types.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprint-free filenames, so HTML must always be revalidated or a deploy can
# leave visitors on a stale page that references assets which no longer exist.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# These three are re-read by crawlers and must never be served stale.
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600

# Long-lived assets. Filenames are stable, so if one is ever replaced in place its
# name has to change too or clients will keep the cached copy for a year.
/img/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# The Intelligence film is scrubbed by scroll, so byte-range requests matter: the
# browser seeks into it rather than streaming from the start.
/*.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable
